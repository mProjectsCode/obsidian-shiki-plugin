{
	"name": "shiki-highlighter",
	"version": "0.7.7",
	"description": "Highlight code blocks with Shiki.",
	"main": "main.js",
	"scripts": {
		"dev": "vite build --mode=development --watch",
		"build": "vite build --mode=production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "bun test",
		"test:log": "LOG_TESTS=true bun test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --report-unused-disable-directives --suppressions-location eslint-ci-suppressions.json",
		"lint:fix": "eslint . --fix --report-unused-disable-directives --suppressions-location eslint-ci-suppressions.json",
		"check": "bun run format:check && bun run typecheck && bun run typecheck:tools && bun run lint && bun run test",
		"release": "bun run release:prepare",
		"lint:review": "eslint . --config eslint.review.config.mjs",
		"verify": "bun run check && bun run build && lemons-automation validate",
		"release:prepare": "lemons-automation release:prepare",
		"package": "bun run build && lemons-automation package",
		"typecheck:tools": "tsc --noEmit -p tsconfig.tools.json"
	},
	"keywords": [],
	"author": "Moritz Jung",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.12.3",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.41.1",
		"@expressive-code/core": "^0.41.7",
		"@expressive-code/plugin-collapsible-sections": "^0.41.7",
		"@expressive-code/plugin-frames": "^0.41.7",
		"@expressive-code/plugin-line-numbers": "^0.41.7",
		"@expressive-code/plugin-shiki": "^0.41.7",
		"@expressive-code/plugin-text-markers": "^0.41.7",
		"@happy-dom/global-registrator": "^20.9.0",
		"@lemons_dev/lemons-obsidian-plugin-automation": "https://github.com/mProjectsCode/lemons-obsidian-plugin-helpers/releases/download/automation-v0.2.8/automation-v0.2.8.tgz",
		"@lezer/common": "^1.5.2",
		"@tsconfig/svelte": "^5.0.8",
		"@types/bun": "1.3.14",
		"@types/prismjs": "^1.26.6",
		"hast-util-to-dom": "^4.0.1",
		"itertools-ts": "^2.5.0",
		"obsidian": "latest",
		"prettier": "3.9.4",
		"shiki": "^3.23.0",
		"tslib": "^2.8.1",
		"typescript": "6.0.3",
		"vite": "8.1.3",
		"vite-plugin-node-polyfills": "^0.26.0",
		"@lemons_dev/eslint-config-obsidian": "https://github.com/mProjectsCode/lemons-obsidian-plugin-helpers/releases/download/eslint-config-v0.1.5/eslint-config-v0.1.5.tgz",
		"eslint": "9.39.4",
		"@types/node": "25.5.0"
	},
	"packageManager": "bun@1.4.0",
	"overrides": {
		"typescript": "6.0.3",
		"typescript-eslint": "8.61.1"
	}
}
